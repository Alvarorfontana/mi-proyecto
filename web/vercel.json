{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fuentes/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/gh/:ruta*",
      "destination": "/api/gh?ruta=:ruta*"
    },
    {
      "source": "/api/ia/:prov/:ruta*",
      "destination": "/api/ia?prov=:prov&ruta=:ruta*"
    }
  ],
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ../plantilla ../fuentes"
}