{
  "name": "Taller editorial",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "bash .devcontainer/instalar.sh",
  "postAttachCommand": {
    "panel": "python panel/servidor.py"
  },
  "forwardPorts": [
    8000
  ],
  "portsAttributes": {
    "8000": {
      "label": "Panel del taller",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "myriad-dreamin.tinymist"
      ]
    }
  },
  "containerEnv": {
    "SIN_NAVEGADOR": "1"
  }
}